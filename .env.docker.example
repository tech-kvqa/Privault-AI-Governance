# Copy to .env next to docker-compose.yml. Generate secrets with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me
JWT_SECRET=
WEBHOOK_ENC_KEY=
PII_INDEX_KEY=
PUBLIC_URL=http://localhost:8080
# Demo data (well-known passwords!) — leave false for anything real:
SEED_DEMO=false
# Set true only if the databases you scan are on a private network:
CONNECTOR_ALLOW_PRIVATE=false
# Recommended: run `node server/scripts/create-tenant.js --name "..." --slug "..." --admin-email "..." --admin-name "..."`
# once the containers are up, instead of SEED_DEMO, to onboard your real first organisation.
