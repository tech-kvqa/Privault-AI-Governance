DATABASE_URL="file:../data/privault-dev.db"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=4100
CORS_ORIGIN="http://localhost:5173"

# Webhooks (Phase 10). Secrets are AES-256-GCM encrypted with a key derived from WEBHOOK_ENC_KEY
# (falls back to JWT_SECRET). Set a dedicated value in production.
WEBHOOK_ENC_KEY="change-this-too"
# Local development ONLY — never enable in production (disables SSRF protections):
# WEBHOOK_ALLOW_PRIVATE=true
# WEBHOOK_ALLOW_INSECURE=true

# Live connectors (Phase 11)
# Key for the keyed-hash index of personal data read from customer databases. Use a value
# DIFFERENT from JWT_SECRET in production. Changing it invalidates existing hashed entries
# (rescan to rebuild).
PII_INDEX_KEY="change-this-as-well"
# Connectors refuse hosts that resolve to private/loopback addresses (SSRF guard). Set to
# "true" for on-premise deployments where the databases you scan ARE on a private network.
CONNECTOR_ALLOW_PRIVATE=false

# Sessions (Phase 13)
SESSION_HOURS=8
SESSION_IDLE_MINUTES=60
AUTH_RATE_LIMIT_MAX=30
# Public rights-request portal (no login) — separate, tighter limits:
PUBLIC_RATE_LIMIT_MAX=10
PUBLIC_LOOKUP_RATE_LIMIT_MAX=60
